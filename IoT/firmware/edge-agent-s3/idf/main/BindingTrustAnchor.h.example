#define EDGE_BINDING_SIGNING_PUBLIC_KEY_PEM \
  "-----BEGIN PUBLIC KEY-----\n" \
  "REPLACE_WITH_BACKEND_BINDING_SIGNING_PUBLIC_KEY\n" \
  "-----END PUBLIC KEY-----\n"
