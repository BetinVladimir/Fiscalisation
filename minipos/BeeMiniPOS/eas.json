{
  "cli": {
    "version": ">=20.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "demo": {
      "distribution": "store",
      "channel": "demo",
      "env": {
        "APP_VARIANT": "demo",
        "EXPO_PUBLIC_MINIPOS_API_URL": "https://demo-api.beeloy.org/public/v1/minipos",
        "EXPO_PUBLIC_FISCAL_API_URL": "https://demo-api.beeloy.org/public/v1",
        "BEELOY_STORE_BUILD": "1",
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_E2E_MODE": "false",
        "EXPO_PUBLIC_E2E_SIMULATOR": "false"
      },
      "environment": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local"
      },
      "ios": {
        "simulator": false,
        "image": "macos-sequoia-15.6-xcode-26.0"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_MINIPOS_API_URL": "https://api.beeloy.org/public/v1/minipos",
        "EXPO_PUBLIC_FISCAL_API_URL": "https://api.beeloy.org/public/v1",
        "BEELOY_STORE_BUILD": "1",
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_E2E_MODE": "false",
        "EXPO_PUBLIC_E2E_SIMULATOR": "false"
      },
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local"
      },
      "ios": {
        "simulator": false,
        "image": "macos-sequoia-15.6-xcode-26.0"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "appleTeamId": "U6TTUVHSL6",
        "ascAppId": "6814689857"
      }
    },
    "demo": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "appleTeamId": "U6TTUVHSL6",
        "ascAppId": "6814689862"
      }
    }
  }
}
