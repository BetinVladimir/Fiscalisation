    "response": "{\"navTitle\": \"Сверка с банком\",\n\"title\": \"Административное решение банка\",\n\"explanation\": \"Этот раздел содержит задокументированные банковские данные. Он не подтверждает наличие фискального чека, не позволяет повторить покупку и не отменяет фискальный возврат. \",\n\"originalOperation\": \"UUID исходной операции\",\n\"payment_id\": \"ID платежа\",\n\"observedState\": \"Текущее состояние банка\",\n\"evidence_reference\": \"Ссылка на банковские данные\",\n\"evidence_sha256\": \"SHA256 банковских данных\",\n\"request\": \"Подписанная банком заявка\",\n\"review\": \"Просмотр подписанного банком решения\",\n\"comparison\": \"Ожидаемый и текущий статус платежа\",\n\"expected\": \"Ожидаемый постоянный статус\",\n\"observed\": \"Текущие банковские данные\",\n\"confirm\": \"Подтвердить и отправить это решение банка\",\n\"recover\": \"Восстановить статус этого решения\",\n\"back\": \"Назад к форме решения\",\n\"saved\": \"Просмотр сохраненного решения {{id}}\",\n\"recorded\": \"Решение банка зафиксировано; фискальный результат остается нерешенным.\",\n\"unresolved\": \"Статус решения: {{state}}. Фискальный результат остается нерешенным.\",\n\"unavailable\": \"Недоступно\",\n\"error\": \"Не удалось загрузить или подтвердить решение банка. Проверьте вашу сессию и подключение. Просмотрите статус сохраненного решения перед повторной отправкой.\",\n\"contextRequired\": \"Требуется активная сессия администратора и контекст выполнения.\",\n\"kind\": \"Тип решения\",\n\"version\": \"Версия формата\",\n\"scope\": \"Область разрешений\",\n\"reconciliation_id\": \"ID сверки\",\n\"tenant_id\": \"ID компании\",\n\"location_id\": \"ID местоположения\",\n\"register_id\": \"ID реестра\",\n\"edge_device_id\": \"ID фискального устройства\",\n\"terminal_id\": \"ID терминала\",\n\"binding_sha256\": \"SHA256 привязки устройства\",\n\"binding_generation\": \"Версия привязки устройства\",\n\"actor_id\": \"ID администратора\",\n\"nbf\": \"Действительно с (секунды Unix)\