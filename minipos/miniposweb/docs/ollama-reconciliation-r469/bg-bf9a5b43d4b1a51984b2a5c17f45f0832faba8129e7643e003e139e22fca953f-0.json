    "response": "{\"navTitle\": \"Съгласуване на банкови транзакции\",\n\"title\": \"Административно банково решение\",\n\"explanation\": \"Този запис документира банкови доказателства. Той не доказва фискален документ, не позволява повторно извършване на плащане или възстановяване на фискални средства.\",\"originalOperation\": \"UUID на оригиналната операция\",\n\"payment_id\": \"Идентификатор на плащането\",\n\"observedState\": \"Наблюдавано банково състояние\",\n\"evidence_reference\": \"Препратка към доказателството на търговеца\",\n\"evidence_sha256\": \"SHA256 на доказателството\",\n\"request\": \"Подписано решение (заявка)\",\n\"review\": \"Преглед на подписаното решение от сървъра\",\n\"comparison\": \"Очаквано и наблюдавано плащане\",\n\"expected\": \"Очаквано трайно състояние\",\n\"observed\": \"Наблюдавано банково доказателство\",\n\"confirm\": \"Потвърдете и изпратете това банково решение\",\n\"recover\": \"Възстановете това състояние на решението\",\n\"back\": \"Обратно към формата за решение\",\n\"saved\": \"Преглед на запазеното решение {{id}}\",\n\"recorded\": \"Банково решение записано; фискалният резултат остава нерешен.\",\n\"unresolved\": \"Състояние на решението: {{state}}. Фискалният резултат остава нерешен.\",\n\"unavailable\": \"Не е налично\",\n\"error\": \"Неуспешно зареждане или потвърждаване на банковото решение. Проверете вашата сесия и връзка. Прегледайте състоянието на запазеното решение, преди да изпратите отново.\",\n\"contextRequired\": \"Необходима е активна администраторска сесия и контекст за изпълнение.\",\n\"kind\": \"Вид на решението\",\n\"version\": \"Версия на формата\",\n\"scope\": \"Обхват на разрешение\",\n\"reconciliation_id\": \"Идентификатор на съгласуването\",\n\"tenant_id\": \"Идентификатор на компанията\",\n\"location_id\": \"Идентификатор на местоположението\",\n\"register_id\": \"Идентификатор на регистъра\",\n\"edge_device_id\": \"Идентификатор на фискално устройство\",\n\"terminal_id\": \"Идентификатор на терминала\",\n\"binding_sha256\": \"SHA256 на връзката на устройството\",\n\"binding_generation\": \"Версия на връзката на устройството\",\n\"actor_id\": \"Идентификатор на администратора\",\n\"nbf\": \"Валидно от (Unix секунди)\",\n\"exp\": \"Валидно до (Unix секунди)\",\n\"operation_id\": \"Идентификатор на операцията\",\n\"receipt_id\": \"Идентификатор на разписката\",\n\"state\": \"Състояние на плащането\",\n\"amount_minor\": \"Сума в по-малки валутни единици\",\n\"terminal_reference\": \"Препратка към терминала\",\n\"rrn\": \"Номер на извличане (RRN)\",\n\"auth_code\": \"Код за оторизация\",\n\"reversal_reference\": \"Препратка за отмяна\",\n\"reversal_rrn\": \"Номер на извличане за отмяна (RRN)\",\n\"reversal_auth_code\": \"Код за оторизация за отмяна\",\n\"stateCARD_APPROVED\": \"Карта одобрена\",\n\"stateCARD_DECLINED\": \"Карта отхвърлена\",\n\"stateCARD_NOT_SENT\": \"Заявка за карта не е изпратена\",\n\"stateCARD_UNKNOWN\": \"Резултат от картата е неизвестен\",\n\"stateREVERSED\": \"Плащане отменено\",\n\"stateREVERSAL_FAILED\": \"Отмяната е неуспешна\"}",
