{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.beeloy.com/pos/deployment-v1.json",
  "title": "Beeloy POS deployment descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "application_id", "version", "build_id", "created_at", "minimum_adapter_api", "entrypoint", "files", "signature"],
  "properties": {
    "schema_version": {"const": 1},
    "application_id": {"const": "com.beeloy.miniposweb"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"},
    "build_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "minimum_adapter_api": {"type": "string", "format": "date"},
    "entrypoint": {"const": "index.html"},
    "files": {
      "type": "array", "minItems": 1, "maxItems": 512,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "size", "sha256", "media_type"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]{1,240}$"},
          "size": {"type": "integer", "minimum": 0, "maximum": 8388608},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "media_type": {"enum": ["text/html", "text/css", "text/javascript", "application/javascript", "application/json", "image/png", "image/svg+xml", "image/webp", "font/woff2"]}
        }
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["kid", "alg", "value"],
      "properties": {
        "kid": {"type": "string", "minLength": 1, "maxLength": 80},
        "alg": {"const": "Ed25519"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
      }
    }
  }
}
