# Local DEV only. Production values must come from the deployment secret manager.
APP_ENV=dev

FISCAL_DB_PASSWORD=dev-fiscal-writer-password
FISCAL_RLS_DB_PASSWORD=dev-fiscal-rls-password
WEBHOOK_SIGNING_KEY=dev-only-fiscal-webhook-key
FISCAL_SITE=:80
FISCAL_HTTP_PORT=8080
FISCAL_HTTPS_PORT=8443

MINIPOS_DB_PASSWORD=dev-minipos-writer-password
MINIPOS_RLS_DB_PASSWORD=dev-minipos-rls-password
FISCAL_PUBLIC_BASE_URL=http://localhost:8080/public/v1
WEBHOOK_VERIFICATION_KEY=dev-only-fiscal-webhook-key
MINIPOS_SITE=:80
MINIPOS_HTTP_PORT=8081
MINIPOS_HTTPS_PORT=8444

# Optional local MQTT integration. Do not use these placeholders in production.
EMQX_JWT_SECRET=dev-only-emqx-secret
EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=dev-only-dashboard-password
FISCAL_BACKEND_EMQX_TOKEN=
BEEMINIPOS_BACKEND_EMQX_TOKEN=
