# Copy this file to .env and fill the required values.
# Every secret is intentionally empty. Never commit a populated .env file.

APP_ENV=dev

# Fiscal database (secrets)
FISCAL_DB_PASSWORD=
FISCAL_RLS_DB_PASSWORD=
FISCAL_POSTGRES_PUBLISH_PORT=5433

# MiniPOS database (secrets)
MINIPOS_DB_PASSWORD=
MINIPOS_RLS_DB_PASSWORD=

# Shared authentication and webhook secrets
AUTH_HMAC_KEY=
BLE_SIGNING_KEY=
WEBHOOK_SIGNING_KEY=
WEBHOOK_VERIFICATION_KEY=
FISCAL_AUTH_TOKEN=

# RabbitMQ
RABBITMQ_DEFAULT_USER=fiscal
RABBITMQ_DEFAULT_PASS=
FISCAL_RABBITMQ_URL=
MINIPOS_RABBITMQ_URL=
RABBITMQ_AMQP_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673

# SMTP / Brevo. SMTP_PASSWORD is the SMTP key, not the account password.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_MAILDOMAIN=mail.beeloy.com
SMTP_FROM=noreply@beeloy.com

# EMQX / MQTT secrets
EMQX_JWT_SECRET=
EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=
FISCAL_BACKEND_EMQX_TOKEN=
BEEMINIPOS_BACKEND_EMQX_TOKEN=
EMQX_TOKEN=

# OAuth/OIDC client secrets
FISCAL_OAUTH_CLIENT_ID=
FISCAL_OAUTH_CLIENT_SECRET=

# Local fiscal-token and SPA signing material
LOCAL_FISCAL_TOKEN_SIGNING_KEY_PEM=
LOCAL_FISCAL_TOKEN_PUBLIC_KEY_DER_BASE64=
SPA_DEPLOYMENT_PUBLIC_KEY_DER_BASE64=

# Non-secret authentication and service settings
AUTH_TOKEN_ISSUER=beeminipos
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
FISCAL_OAUTH_TOKEN_URL=
FISCAL_OAUTH_SCOPE=fiscal.base
FISCAL_OAUTH_AUDIENCE=beefiscal
LOCAL_FISCAL_TOKEN_ISSUER=beeminipos
LOCAL_FISCAL_TOKEN_SIGNING_KID=minipos-local-1
SPA_DEPLOYMENT_DESCRIPTOR_URL=
SPA_DEPLOYMENT_SIGNING_KID=

# Public endpoints
FISCAL_PUBLIC_BASE_URL=http://localhost:8080/public/v1
FISCAL_SITE=:80
FISCAL_HTTP_PORT=8080
FISCAL_HTTPS_PORT=8443
MINIPOS_SITE=:80
MINIPOS_HTTP_PORT=8081
MINIPOS_HTTPS_PORT=8444

# Device MQTT endpoints and local PKI paths
DEVICE_MQTT_TLS_URI=
DEVICE_MQTT_WSS_URI=
DEVICE_CA_CERT_FILE=
DEVICE_CA_KEY_FILE=
DEVICE_PKI_DIR=./deploy/device-pki
