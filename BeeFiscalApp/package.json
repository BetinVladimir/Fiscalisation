{
  "name": "beefiscalapp",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "test:e2e": "npm run build:e2e && playwright test",
    "build:e2e": "EXPO_PUBLIC_FISCAL_API_URL=http://fiscal-admin.test/public/v1 expo export --clear --platform web --output-dir .playwright-e2e-web",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "store:check": "node store/release.cjs check",
    "store:setup": "node store/release.cjs setup",
    "build:android": "node store/release.cjs build android production",
    "submit:android": "node store/release.cjs submit android production",
    "deploy:android": "node store/release.cjs deploy android production",
    "build:android:demo": "node store/release.cjs build android demo",
    "submit:android:demo": "node store/release.cjs submit android demo",
    "deploy:android:demo": "node store/release.cjs deploy android demo",
    "build:ios": "node store/release.cjs build ios production",
    "submit:ios": "node store/release.cjs submit ios production",
    "deploy:ios": "node store/release.cjs deploy ios production",
    "build:ios:demo": "node store/release.cjs build ios demo",
    "submit:ios:demo": "node store/release.cjs submit ios demo",
    "deploy:ios:demo": "node store/release.cjs deploy ios demo",
    "store:keys": "node store/android-key.cjs",
    "store:validate": "node store/validate.cjs",
    "testflight:build": "node store/release.cjs build ios production",
    "testflight:build:demo": "node store/release.cjs build ios demo",
    "testflight:upload": "node store/release.cjs submit ios production",
    "testflight:upload:demo": "node store/release.cjs submit ios demo",
    "build:web:production": "node scripts/build-web.mjs production",
    "build:web:demo": "node scripts/build-web.mjs demo",
    "deploy:web": "npm run build:web:production && wrangler deploy --env=\"\"",
    "deploy:web-demo": "npm run build:web:demo && wrangler deploy --env demo",
    "ui:check": "node scripts/check-ui-guideline.mjs && node scripts/check-contrast.mjs",
    "ui:contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/roboto": "^0.2.3",
    "@expo/metro-runtime": "~6.1.2",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.20",
    "postcss": "8.5.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-ble-plx": "^3.5.1",
    "react-native-paper": "^5.15.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "typescript": "~5.9.2",
    "wrangler": "4.131.1"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
