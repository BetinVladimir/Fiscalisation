{
  "name": "beefiscalapp",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "test:e2e": "playwright test",
    "build:e2e": "expo export --clear --platform web --output-dir .playwright-e2e-web",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.4",
    "expo": "~53.0.0",
    "expo-crypto": "~14.1.5",
    "expo-secure-store": "~14.2.3",
    "expo-status-bar": "~2.0.0",
    "postcss": "8.5.23",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.0",
    "react-native-ble-plx": "^3.5.1",
    "react-native-web": "~0.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
